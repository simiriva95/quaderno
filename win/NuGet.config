<?xml version="1.0" encoding="utf-8"?>
<!--
  Il pacchetto che serve qui è uno e sta su nuget.org. Senza questo file
  valgono le sorgenti configurate sulla macchina, e una sorgente privata che
  chiede le credenziali fa fallire il ripristino per un motivo che con il
  quaderno non c'entra niente.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
